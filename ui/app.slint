import { Palette } from "std-widgets.slint";
import {
    Win11Theme, TorrentItem, TorrentFileItem, SearchResultItem, ScreenshotItem,
    HistoryItem, LogEntry, ModuleListItem, PeerItem, SpeedSample, WorkspaceBlockItem
} from "theme.slint";
import { AppState } from "globals.slint";
import { FluentButton } from "components.slint";
import { DesktopSidebar } from "sidebar.slint";
import { MobileHeaderBar, MobileBottomTabs, MobileNavDrawer, LightboxModal, SyncConflictModal, ToastBanner } from "overlays.slint";
import { ContextSidePanel } from "context_panel.slint";
import { SettingsView } from "settings_view.slint";
import { TorrentsView } from "modules/torrserver/torrents_view.slint";
import { SearchView } from "modules/torrserver/search_view.slint";
import { HistoryView } from "modules/torrserver/history_view.slint";
import { WorkspaceBuilderView } from "workspace_builder.slint";
import { StatusBar } from "status_bar.slint";
import { DetachedWindow } from "detached_window.slint";

export {
    Win11Theme, AppState, DetachedWindow, TorrentItem, TorrentFileItem, SearchResultItem,
    ScreenshotItem, HistoryItem, LogEntry, ModuleListItem, PeerItem, SpeedSample, WorkspaceBlockItem
}

export component AppWindow inherits Window {
    title: "TorrServerUI";
    min-width: 360px; min-height: 540px;
    preferred-width: 1280px; preferred-height: 780px;
    background: Win11Theme.window-bg;

    in property <image> app-icon;
    icon: root.app-icon;
    init => { Win11Theme.viewport-width = root.width; }
    changed width => { Win11Theme.viewport-width = root.width; }

    // Navigation & Shell State
    in-out property <int> active-tab <=> AppState.active-tab;
    in-out property <int> detached-tab: -1;
    in-out property <bool> status-healthy: false;
    in-out property <string> status-text: "Инициализация...";
    in-out property <string> status-version: "";
    in-out property <string> status-speed: "0 KB/s";
    in-out property <int> status-active-count: 0;
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible: false;

    // Torrents View
    in-out property <string> magnet-input: "";
    in-out property <[TorrentItem]> torrents <=> AppState.torrents;
    in-out property <int> torrents-sort-mode: 0;
    in-out property <string> selected-torrent-hash: "";
    in-out property <string> selected-torrent-title: "";
    in-out property <[TorrentFileItem]> selected-files <=> AppState.selected-files;
    in-out property <bool> only-video-files: true;
    in-out property <bool> engine-missing: false;
    in-out property <bool> engine-updating: false;
    in-out property <string> engine-update-status: "";
    in-out property <float> engine-update-progress: 0.0;
    in-out property <[string]> engine-version-presets;
    in-out property <int> engine-version-selected-idx: 0;
    in-out property <bool> engine-versions-loading: false;
    in-out property <bool> is-remote-mode: false;

    // Context Detail Panel & Info Modal
    in-out property <bool> detail-panel-open: true;
    in-out property <bool> detail-loading: false;
    in-out property <string> detail-title: "";
    in-out property <string> detail-original-title: "";
    in-out property <string> detail-year: "";
    in-out property <string> detail-genres: "";
    in-out property <string> detail-country: "";
    in-out property <string> detail-rating-kp: "";
    in-out property <string> detail-rating-imdb: "";
    in-out property <string> detail-description: "";
    in-out property <string> detail-source: "";
    in-out property <string> detail-tracker-url: "";
    in-out property <image> detail-poster;
    in-out property <bool> detail-has-poster: false;
    in-out property <[ScreenshotItem]> detail-screenshots;

    in-out property <bool> torrent-info-visible: false;
    in-out property <string> info-hash: "";
    in-out property <string> info-title: "";
    in-out property <string> info-size: "";
    in-out property <string> info-added: "";
    in-out property <string> info-status: "";
    in-out property <string> info-speed: "";
    in-out property <string> info-peers: "";
    in-out property <string> info-files-count: "";
    in-out property <string> info-tracker-url: "";
    in-out property <string> info-ratings: "";
    in-out property <string> info-magnet: "";

    // Lightbox & WebDAV Conflict Modals
    in-out property <bool> lightbox-visible: false;
    in-out property <image> lightbox-image;
    in-out property <string> lightbox-url: "";
    in-out property <bool> sync-conflict-visible: false;
    in-out property <string> sync-conflict-info: "";

    // Search & History
    in-out property <string> search-query: "";
    in-out property <string> search-quality-filter: "ALL";
    in-out property <int> search-sort-mode: 0;
    in-out property <int> search-source-mode: 0;
    in-out property <bool> search-loading: false;
    in-out property <string> search-error: "";
    in-out property <[SearchResultItem]> search-results <=> AppState.search-results;
    in-out property <bool> history-only-favorites: false;
    in-out property <[HistoryItem]> history-items <=> AppState.history-items;

    // Settings: TorrServer
    in-out property <int> ts-mode: 0;
    in-out property <string> ts-port: "8090";
    in-out property <string> ts-remote-url: "http://127.0.0.1:8090";
    in-out property <string> ts-username: "";
    in-out property <string> ts-password: "";
    in-out property <string> ts-engine-version-text: "Не обнаружен";
    in-out property <bool> engine-watchdog: true;
    in-out property <bool> keep-engine-on-exit: false;
    in-out property <string> kp-api-key: "";
    in-out property <string> ts-browser-url: "http://127.0.0.1:8090";
    in-out property <string> ts-lan-url: "";
    in-out property <bool> ts-has-lan-ip: false;
    in-out property <string> ts-cache-size-mb: "64";
    in-out property <string> ts-preload-percent: "50";
    in-out property <string> ts-read-ahead-percent: "95";
    in-out property <string> ts-connections-limit: "25";
    in-out property <bool> ts-use-disk: false;
    in-out property <bool> ts-enable-ipv6: false;
    in-out property <bool> ts-enable-dlna: false;
    in-out property <bool> ts-enable-rutor: true;
    in-out property <int> player-selected-idx: 0;
    in-out property <[string]> player-presets;
    in-out property <string> player-custom-path: "";
    in-out property <string> player-args: "";
    in-out property <bool> clipboard-watch: false;
    in-out property <string> player-detect-status: "";
    in-out property <bool> rt-enabled: false;
    in-out property <bool> rt-use-webview: false;
    in-out property <string> rt-mirror: "https://rutracker.org";
    in-out property <string> rt-username: "";
    in-out property <string> rt-password: "";
    in-out property <string> rt-proxy: "";
    in-out property <string> rt-cookie: "";
    in-out property <string> rt-user-agent: "";
    in-out property <string> rt-auth-status: "";
    in-out property <bool> rt-testing: false;

    // Settings: Core, WebDAV, Profiler, About & Diagnostics
    in-out property <int> theme-mode <=> Win11Theme.theme-mode;
    in-out property <int> autostart-mode: 0;
    in-out property <bool> autostart-needs-repair: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> keep-in-memory: true;
    in-out property <[ModuleListItem]> registered-modules <=> AppState.registered-modules;
    in-out property <bool> webdav-enabled: false;
    in-out property <int> webdav-preset: 0;
    in-out property <string> webdav-url: "https://webdav.yandex.ru";
    in-out property <string> webdav-user: "";
    in-out property <string> webdav-pass: "";
    in-out property <bool> webdav-sync-db: false;
    in-out property <int> secret-mode: 0;
    in-out property <string> master-password: "";
    in-out property <bool> profiler-enabled: false;
    in-out property <string> profiler-cpu: "0%";
    in-out property <string> profiler-working-set: "0 МБ";
    in-out property <string> profiler-private-bytes: "0 МБ";
    in-out property <string> profiler-handles: "0";
    in-out property <string> profiler-gdi-user: "0 / 0";
    in-out property <string> profiler-crash-status: "crash.log отсутствует";
    in-out property <string> changelog-text: "";
    in-out property <string> update-check-status: "";
    in-out property <bool> diag-expander-open: false;
    in-out property <string> diag-app-version: "0.2.0";
    in-out property <string> diag-engine-version: "-";
    in-out property <string> diag-binary-status: "-";
    in-out property <string> diag-port-status: "-";
    in-out property <string> diag-api-ping: "-";
    in-out property <string> diag-problem-hint: "Всё работает штатно";
    in-out property <bool> diag-has-problem: false;
    in-out property <[LogEntry]> diag-logs <=> AppState.diag-logs;

    // Callbacks (TorrServer + Core + Services + Workspace)
    callback add-magnet(string); callback paste-and-add-magnet(); callback pick-torrent-file();
    callback select-torrent(string); callback refresh-torrents(); callback set-torrents-sort(int);
    callback set-torrents-filter(int); callback drop-torrent(string); callback remove-torrent(string);
    callback copy-torrent-magnet(string); callback play-file(string, int); callback play-all-m3u(string);
    callback copy-stream-url(string, int); callback toggle-only-video(bool);
    callback export-torrents(); callback import-torrents(); callback download-torrent-playlist(string);
    callback download-all-playlist(); callback refresh-single-torrent(string);
    callback show-torrent-info(string); callback open-tracker-page(string);
    callback refresh-torrent-metadata(string); callback open-external-url(string); callback watch-trailer(string, string);
    callback search-torrents(string); callback fetch-top-24h(); callback set-search-quality(string);
    callback set-search-sort(int); callback set-search-source(int);
    callback add-search-result(string, string, string); callback play-search-result(string, string, string);
    callback toggle-history-favorites(bool); callback play-history-item(string, string);
    callback toggle-history-favorite(string); callback remove-history-item(string);
    callback save-ts-connection-settings(); callback restart-ts-engine(); callback select-engine-version(int);
    callback refresh-engine-versions(); callback download-update-engine(); callback pick-engine-exe();
    callback open-web-panel(); callback copy-ts-browser-url(); callback copy-ts-lan-url();
    callback refresh-ts-addresses(); callback save-ts-cache-settings(); callback detect-players();
    callback pick-player-exe(); callback save-player-settings(); callback save-and-test-rutracker(); callback open-rutracker-webview();
    callback change-theme-mode(int); callback change-language(int); callback set-autostart-mode(int);
    callback repair-autostart(); callback toggle-start-minimized(bool); callback toggle-close-to-tray(bool);
    callback toggle-keep-in-memory(bool); callback save-webdav-settings(); callback test-webdav-connection();
    callback sync-webdav-now(); callback resolve-sync-conflict(int); callback toggle-profiler(bool);
    callback export-profiler-report(); callback check-github-updates(); callback detach-module(int);
    callback run-diagnostics-now(); callback copy-diagnostics-report(); callback copy-diagnostics-for-ai();
    callback clear-diagnostics-logs(); callback open-diagnostics-tab();
    callback ws-load-preset(int); callback ws-save-preset(string); callback ws-delete-preset(int);
    callback ws-set-block-span(string, int); callback ws-move-block(string, int);

    public function apply-theme(mode: int, sys-dark: bool) {
        Win11Theme.theme-mode = mode;
        Win11Theme.system-is-dark = sys-dark;
        if (mode == 1) { Palette.color-scheme = ColorScheme.light; }
        else if (mode == 2) { Palette.color-scheme = ColorScheme.dark; }
        else { Palette.color-scheme = sys-dark ? ColorScheme.dark : ColorScheme.light; }
    }

    property <length> swipe-start-x: 0px;
    property <length> swipe-start-y: 0px;
    property <bool> swipe-tracking: false;

    VerticalLayout {
        if (Win11Theme.is-mobile) : MobileHeaderBar { }

        main-body := HorizontalLayout {
            vertical-stretch: 1;

            if (!Win11Theme.is-mobile) : DesktopSidebar {
                app-icon: root.app-icon; active-tab <=> root.active-tab; theme-mode <=> root.theme-mode;
                ts-has-lan-ip: root.ts-has-lan-ip; ts-lan-url: root.ts-lan-url; ts-browser-url: root.ts-browser-url;
                detach-module(t) => { root.detach-module(t); } copy-ts-lan-url => { root.copy-ts-lan-url(); }
                refresh-ts-addresses => { root.refresh-ts-addresses(); } change-theme-mode(m) => { root.change-theme-mode(m); }
            }
            if (!Win11Theme.is-mobile) : Rectangle { width: 1px; background: Win11Theme.border-color; }

            // Central Workspace
            Rectangle {
                horizontal-stretch: 1; background: Win11Theme.window-bg; clip: true;

                if (root.detached-tab == root.active-tab && root.detached-tab != -1) : VerticalLayout {
                    alignment: center; spacing: 8px;
                    Text { text: @tr("Раздел открыт в отдельном окне"); font-family: Win11Theme.font-ui; font-size: 14px; font-weight: 600; color: Win11Theme.text-primary; horizontal-alignment: center; }
                    HorizontalLayout { alignment: center; FluentButton { primary: true; text: @tr("Вернуть сюда"); clicked => { root.detach-module(-1); } } }
                }

                if (root.active-tab == 0 && root.detached-tab != 0) : TorrentsView {
                    magnet-input <=> root.magnet-input; torrents: root.torrents; torrents-sort-mode <=> root.torrents-sort-mode;
                    selected-torrent-hash: root.selected-torrent-hash; engine-missing: root.engine-missing;
                    engine-updating: root.engine-updating; engine-update-status: root.engine-update-status;
                    engine-update-progress: root.engine-update-progress; engine-version-presets: root.engine-version-presets;
                    engine-version-selected-idx <=> root.engine-version-selected-idx; engine-versions-loading: root.engine-versions-loading;
                    is-remote-mode: root.is-remote-mode; status-healthy: root.status-healthy;
                    torrent-info-visible <=> root.torrent-info-visible; info-hash: root.info-hash; info-title: root.info-title;
                    info-size: root.info-size; info-added: root.info-added; info-status: root.info-status;
                    info-speed: root.info-speed; info-peers: root.info-peers; info-files-count: root.info-files-count;
                    info-tracker-url: root.info-tracker-url; info-ratings: root.info-ratings; info-magnet: root.info-magnet;
                    add-magnet(m) => { root.add-magnet(m); } paste-and-add-magnet => { root.paste-and-add-magnet(); }
                    pick-torrent-file => { root.pick-torrent-file(); } select-torrent(h) => { root.select-torrent(h); }
                    refresh-torrents => { root.refresh-torrents(); } set-torrents-sort(m) => { root.set-torrents-sort(m); }
                    set-torrents-filter(f) => { root.set-torrents-filter(f); } drop-torrent(h) => { root.drop-torrent(h); }
                    remove-torrent(h) => { root.remove-torrent(h); } copy-torrent-magnet(h) => { root.copy-torrent-magnet(h); }
                    play-file(h, fid) => { root.play-file(h, fid); } select-engine-version(i) => { root.select-engine-version(i); }
                    refresh-engine-versions => { root.refresh-engine-versions(); } download-update-engine => { root.download-update-engine(); }
                    pick-engine-exe => { root.pick-engine-exe(); } export-torrents => { root.export-torrents(); }
                    import-torrents => { root.import-torrents(); } download-torrent-playlist(h) => { root.download-torrent-playlist(h); }
                    download-all-playlist => { root.download-all-playlist(); } refresh-single-torrent(h) => { root.refresh-single-torrent(h); }
                    show-torrent-info(h) => { root.show-torrent-info(h); } open-tracker-page(h) => { root.open-tracker-page(h); }
                }

                if (root.active-tab == 1 && root.detached-tab != 1) : SearchView {
                    search-query <=> root.search-query; quality-filter: root.search-quality-filter;
                    sort-mode: root.search-sort-mode; source-mode: root.search-source-mode;
                    loading: root.search-loading; error-text: root.search-error; results: root.search-results;
                    search-torrents(q) => { root.search-torrents(q); } fetch-top-24h => { root.fetch-top-24h(); }
                    set-quality(q) => { root.set-search-quality(q); } set-sort(s) => { root.set-search-sort(s); }
                    set-source(src) => { root.set-search-source(src); }
                    add-search-result(m, t, u) => { root.add-search-result(m, t, u); } play-search-result(m, t, u) => { root.play-search-result(m, t, u); }
                }

                if (root.active-tab == 2 && root.detached-tab != 2) : HistoryView {
                    only-favorites <=> root.history-only-favorites; items: root.history-items;
                    toggle-favorites-filter(v) => { root.toggle-history-favorites(v); } play-history-item(h, m) => { root.play-history-item(h, m); }
                    toggle-favorite(h) => { root.toggle-history-favorite(h); } remove-history-item(h) => { root.remove-history-item(h); }
                }

                if (root.active-tab == 4 && root.detached-tab != 4) : WorkspaceBuilderView {
                    load-preset(i) => { root.ws-load-preset(i); } save-preset(n) => { root.ws-save-preset(n); }
                    delete-preset(i) => { root.ws-delete-preset(i); } set-block-span(id, s) => { root.ws-set-block-span(id, s); }
                    move-block(id, d) => { root.ws-move-block(id, d); }
                }

                if (root.active-tab == 3) : SettingsView {
                    ts-mode <=> root.ts-mode; ts-port <=> root.ts-port; ts-remote-url <=> root.ts-remote-url;
                    ts-username <=> root.ts-username; ts-password <=> root.ts-password; ts-engine-version-text: root.ts-engine-version-text;
                    engine-updating: root.engine-updating; engine-update-status: root.engine-update-status; engine-update-progress: root.engine-update-progress;
                    engine-version-presets: root.engine-version-presets; engine-version-selected-idx <=> root.engine-version-selected-idx;
                    engine-versions-loading: root.engine-versions-loading; engine-watchdog <=> root.engine-watchdog;
                    keep-engine-on-exit <=> root.keep-engine-on-exit; kp-api-key <=> root.kp-api-key;
                    ts-browser-url: root.ts-browser-url; ts-lan-url: root.ts-lan-url; ts-has-lan-ip: root.ts-has-lan-ip;
                    ts-cache-size-mb <=> root.ts-cache-size-mb; ts-preload-percent <=> root.ts-preload-percent;
                    ts-read-ahead-percent <=> root.ts-read-ahead-percent; ts-connections-limit <=> root.ts-connections-limit;
                    ts-use-disk <=> root.ts-use-disk; ts-enable-ipv6 <=> root.ts-enable-ipv6;
                    ts-enable-dlna <=> root.ts-enable-dlna; ts-enable-rutor <=> root.ts-enable-rutor;
                    player-selected-idx <=> root.player-selected-idx; player-presets: root.player-presets;
                    player-custom-path <=> root.player-custom-path; player-args <=> root.player-args;
                    clipboard-watch <=> root.clipboard-watch; player-detect-status: root.player-detect-status;
                    rt-enabled <=> root.rt-enabled; rt-use-webview <=> root.rt-use-webview; rt-mirror <=> root.rt-mirror;
                    rt-username <=> root.rt-username; rt-password <=> root.rt-password; rt-proxy <=> root.rt-proxy;
                    rt-cookie <=> root.rt-cookie; rt-user-agent <=> root.rt-user-agent; rt-auth-status: root.rt-auth-status; rt-testing: root.rt-testing;
                    theme-mode <=> root.theme-mode; autostart-mode <=> root.autostart-mode; autostart-needs-repair: root.autostart-needs-repair;
                    start-minimized <=> root.start-minimized; close-to-tray <=> root.close-to-tray; keep-in-memory <=> root.keep-in-memory;
                    registered-modules: root.registered-modules; webdav-enabled <=> root.webdav-enabled; webdav-preset <=> root.webdav-preset;
                    webdav-url <=> root.webdav-url; webdav-user <=> root.webdav-user; webdav-pass <=> root.webdav-pass;
                    webdav-sync-db <=> root.webdav-sync-db; secret-mode <=> root.secret-mode; master-password <=> root.master-password;
                    profiler-enabled <=> root.profiler-enabled; profiler-cpu: root.profiler-cpu; profiler-working-set: root.profiler-working-set;
                    profiler-private-bytes: root.profiler-private-bytes; profiler-handles: root.profiler-handles; profiler-gdi-user: root.profiler-gdi-user;
                    profiler-crash-status: root.profiler-crash-status; app-version: root.diag-app-version;
                    changelog-text: root.changelog-text; update-check-status: root.update-check-status;
                    save-ts-connection-settings => { root.save-ts-connection-settings(); } restart-ts-engine => { root.restart-ts-engine(); }
                    select-engine-version(i) => { root.select-engine-version(i); } refresh-engine-versions => { root.refresh-engine-versions(); }
                    download-update-engine => { root.download-update-engine(); } pick-engine-exe => { root.pick-engine-exe(); }
                    open-web-panel => { root.open-web-panel(); } copy-ts-browser-url => { root.copy-ts-browser-url(); }
                    copy-ts-lan-url => { root.copy-ts-lan-url(); } refresh-ts-addresses => { root.refresh-ts-addresses(); }
                    save-ts-cache-settings => { root.save-ts-cache-settings(); } detect-players => { root.detect-players(); }
                    pick-player-exe => { root.pick-player-exe(); } save-player-settings => { root.save-player-settings(); }
                    save-and-test-rutracker => { root.save-and-test-rutracker(); } open-rutracker-webview => { root.open-rutracker-webview(); }
                    change-theme-mode(m) => { root.change-theme-mode(m); } change-language(l) => { root.change-language(l); }
                    set-autostart-mode(m) => { root.set-autostart-mode(m); } repair-autostart => { root.repair-autostart(); }
                    toggle-start-minimized(v) => { root.toggle-start-minimized(v); } toggle-close-to-tray(v) => { root.toggle-close-to-tray(v); }
                    toggle-keep-in-memory(v) => { root.toggle-keep-in-memory(v); } save-webdav-settings => { root.save-webdav-settings(); }
                    test-webdav-connection => { root.test-webdav-connection(); } sync-webdav-now => { root.sync-webdav-now(); }
                    toggle-profiler(v) => { root.toggle-profiler(v); } export-profiler-report => { root.export-profiler-report(); }
                    check-github-updates => { root.check-github-updates(); }
                }
            }

            // Reserved layout space for Desktop Context Panel (320px)
            if (Win11Theme.is-desktop && (root.detail-panel-open || root.active-tab == 3)) : Rectangle {
                width: Win11Theme.detail-w; background: Win11Theme.window-bg;
            }
        }

        if (Win11Theme.is-mobile) : MobileBottomTabs { active-tab <=> root.active-tab; }
        StatusBar {
            healthy: root.status-healthy; status-text: root.status-text; status-version: root.status-version;
            status-speed: root.status-speed; active-count: root.status-active-count; app-version: root.diag-app-version;
            open-diagnostics => { root.open-diagnostics-tab(); }
        }
    }

    // Touch / Pointer Swipe Zone (Mobile & Tablet bottom edge-free strip)
    if (!Win11Theme.is-desktop) : TouchArea {
        x: 24px; y: root.height - (Win11Theme.is-mobile ? 80px : 32px);
        width: max(0px, root.width - 48px); height: 28px;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) { root.swipe-start-x = self.mouse-x; root.swipe-start-y = self.mouse-y; root.swipe-tracking = true; }
            else if (ev.kind == PointerEventKind.up && root.swipe-tracking) {
                root.swipe-tracking = false;
                if (self.mouse-x - root.swipe-start-x > 45px && (self.mouse-x - root.swipe-start-x) > (self.mouse-y - root.swipe-start-y) && (self.mouse-x - root.swipe-start-x) > (root.swipe-start-y - self.mouse-y)) {
                    if (AppState.mobile-detail-open) { AppState.mobile-detail-open = false; } else if (Win11Theme.is-mobile) { AppState.mobile-drawer-open = true; }
                } else if (root.swipe-start-x - self.mouse-x > 45px && (root.swipe-start-x - self.mouse-x) > (self.mouse-y - root.swipe-start-y) && (root.swipe-start-x - self.mouse-x) > (root.swipe-start-y - self.mouse-y)) {
                    if (AppState.mobile-drawer-open) { AppState.mobile-drawer-open = false; } else { AppState.mobile-detail-open = true; }
                }
            }
        }
    }

    if (Win11Theme.is-mobile && AppState.mobile-drawer-open) : MobileNavDrawer {
        x: 0px; y: 0px; width: root.width; height: root.height;
        active-tab <=> root.active-tab; theme-mode <=> root.theme-mode;
        change-theme-mode(m) => { root.change-theme-mode(m); }
    }

    if (!Win11Theme.is-desktop && AppState.mobile-detail-open) : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: #00000070;
        TouchArea { clicked => { AppState.mobile-detail-open = false; } }
    }

    // Single shared ContextSidePanel (Desktop right column OR Mobile/Tablet slide-over drawer)
    if ((Win11Theme.is-desktop && (root.detail-panel-open || root.active-tab == 3)) || (!Win11Theme.is-desktop && AppState.mobile-detail-open)) : Rectangle {
        x: Win11Theme.is-desktop ? (root.width - Win11Theme.detail-w) : (root.width - min(340px, root.width * 0.92));
        y: Win11Theme.is-desktop ? (main-body.y + 12px) : 0px;
        width: Win11Theme.is-desktop ? max(0px, Win11Theme.detail-w - 12px) : min(340px, root.width * 0.92);
        height: Win11Theme.is-desktop ? max(0px, main-body.height - 24px) : root.height;
        background: Win11Theme.window-bg;
        TouchArea { }
        ContextSidePanel {
            width: parent.width; height: parent.height; active-tab: root.active-tab;
            diag-app-version: root.diag-app-version; diag-engine-version: root.diag-engine-version; diag-binary-status: root.diag-binary-status;
            diag-port-status: root.diag-port-status; diag-api-ping: root.diag-api-ping; diag-problem-hint: root.diag-problem-hint; diag-has-problem: root.diag-has-problem;
            torrent-hash: root.selected-torrent-hash; torrent-title: root.selected-torrent-title; loading: root.detail-loading;
            title: root.detail-title; original-title: root.detail-original-title; year: root.detail-year; genres: root.detail-genres;
            country: root.detail-country; rating-kp: root.detail-rating-kp; rating-imdb: root.detail-rating-imdb; description: root.detail-description;
            source-label: root.detail-source; tracker-url: root.detail-tracker-url; poster: root.detail-poster; has-poster: root.detail-has-poster;
            screenshots: root.detail-screenshots; files: root.selected-files; only-video-files <=> root.only-video-files;
            run-diagnostics-now => { root.run-diagnostics-now(); } copy-diagnostics-report => { root.copy-diagnostics-report(); }
            copy-diagnostics-for-ai => { root.copy-diagnostics-for-ai(); } clear-diagnostics-logs => { root.clear-diagnostics-logs(); }
            close-panel => { if (Win11Theme.is-desktop) { root.detail-panel-open = false; } else { AppState.mobile-detail-open = false; } }
            refresh-metadata(h) => { root.refresh-torrent-metadata(h); }
            play-file(h, id) => { root.play-file(h, id); } play-all-m3u(h) => { root.play-all-m3u(h); }
            copy-stream-url(h, id) => { root.copy-stream-url(h, id); } toggle-only-video(v) => { root.toggle-only-video(v); }
            open-external-url(u) => { root.open-external-url(u); }
            open-lightbox(img, u) => { root.lightbox-image = img; root.lightbox-url = u; root.lightbox-visible = true; }
            watch-trailer(h, t) => { root.watch-trailer(h, t); }
        }
    }

    if (root.lightbox-visible) : LightboxModal {
        x: 0px; y: 0px; width: root.width; height: root.height;
        open <=> root.lightbox-visible; img: root.lightbox-image; url: root.lightbox-url;
        open-external-url(u) => { root.open-external-url(u); }
    }
    if (root.sync-conflict-visible) : SyncConflictModal {
        x: 0px; y: 0px; width: root.width; height: root.height;
        open <=> root.sync-conflict-visible; info: root.sync-conflict-info;
        resolve(c) => { root.resolve-sync-conflict(c); }
    }
    if (root.toast-visible) : ToastBanner {
        x: (root.width - self.width) / 2; y: root.height - 76px;
        width: min(root.width - 24px, 400px); message: root.toast-message;
    }
}
