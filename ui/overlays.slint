import { Win11Theme } from "theme.slint";
import { AppState } from "globals.slint";
import { FluentCard, FluentButton, FluentNavItem, ThemeSelector } from "components.slint";

export component MobileHeaderBar inherits Rectangle {
    height: 44px;
    background: Win11Theme.sidebar-bg;
    border-width: 1px;
    border-color: Win11Theme.border-color;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        FluentButton {
            compact: true;
            icon-path: "M 4 6 L 20 6 M 4 12 L 20 12 M 4 18 L 20 18";
            clicked => { AppState.mobile-drawer-open = !AppState.mobile-drawer-open; }
        }
        Text {
            horizontal-stretch: 1;
            text: "TorrServerUI";
            font-family: Win11Theme.font-ui;
            font-size: 14px;
            font-weight: 600;
            color: Win11Theme.text-primary;
            vertical-alignment: center;
        }
        FluentButton {
            compact: true;
            icon-path: "M 12 3 L 20 7 L 20 17 L 12 21 L 4 17 L 4 7 Z";
            clicked => { AppState.mobile-detail-open = !AppState.mobile-detail-open; }
        }
    }
}

export component MobileBottomTabs inherits Rectangle {
    in-out property <int> active-tab: 0;
    height: 48px;
    background: Win11Theme.sidebar-bg;
    border-width: 1px;
    border-color: Win11Theme.border-color;
    HorizontalLayout {
        for tab in [
            { idx: 0, label: @tr("Раздачи") },
            { idx: 1, label: @tr("Поиск") },
            { idx: 2, label: @tr("История") },
            { idx: 3, label: @tr("Настройки") },
        ] : Rectangle {
            horizontal-stretch: 1;
            background: root.active-tab == tab.idx ? Win11Theme.nav-active : transparent;
            TouchArea { clicked => { root.active-tab = tab.idx; } }
            Text {
                text: tab.label;
                font-family: Win11Theme.font-ui;
                font-size: 11px;
                font-weight: root.active-tab == tab.idx ? 600 : 400;
                color: root.active-tab == tab.idx ? Win11Theme.accent : Win11Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component MobileNavDrawer inherits Rectangle {
    in-out property <int> active-tab: 0;
    in-out property <int> theme-mode: 0;
    callback change-theme-mode(int);

    background: #00000070;
    TouchArea { clicked => { AppState.mobile-drawer-open = false; } }
    Rectangle {
        x: 0px; y: 0px; width: min(240px, root.width * 0.8); height: root.height;
        background: Win11Theme.sidebar-bg;
        TouchArea { }
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text { text: "TorrServerUI"; font-family: Win11Theme.font-ui; font-size: 15px; font-weight: 600; color: Win11Theme.text-primary; }
            FluentNavItem { label: @tr("Раздачи"); active: root.active-tab == 0; clicked => { root.active-tab = 0; AppState.mobile-drawer-open = false; } }
            FluentNavItem { label: @tr("Поиск"); active: root.active-tab == 1; clicked => { root.active-tab = 1; AppState.mobile-drawer-open = false; } }
            FluentNavItem { label: @tr("История"); active: root.active-tab == 2; clicked => { root.active-tab = 2; AppState.mobile-drawer-open = false; } }
            FluentNavItem { label: @tr("Конструктор"); active: root.active-tab == 4; clicked => { root.active-tab = 4; AppState.mobile-drawer-open = false; } }
            FluentNavItem { label: @tr("Настройки"); active: root.active-tab == 3; clicked => { root.active-tab = 3; AppState.mobile-drawer-open = false; } }
            Rectangle { vertical-stretch: 1; }
            ThemeSelector { mode <=> root.theme-mode; changed(m) => { root.change-theme-mode(m); } }
        }
    }
}

export component LightboxModal inherits Rectangle {
    in-out property <bool> open: false;
    in property <image> img;
    in property <string> url: "";
    callback open-external-url(string);

    background: #000000C8;
    TouchArea { clicked => { root.open = false; } }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if (root.url != "") : FluentButton { compact: true; text: @tr("Открыть в браузере"); clicked => { root.open-external-url(root.url); } }
            FluentButton { compact: true; primary: true; text: @tr("Закрыть"); clicked => { root.open = false; } }
        }
        Image { vertical-stretch: 1; source: root.img; image-fit: contain; }
    }
}

export component SyncConflictModal inherits Rectangle {
    in-out property <bool> open: false;
    in property <string> info: "";
    callback resolve(int);

    background: #00000080;
    TouchArea { }
    FluentCard {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 24px, 420px);
        height: 180px;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: @tr("Конфликт базы данных WebDAV"); font-family: Win11Theme.font-ui; font-size: 14px; font-weight: 600; color: Win11Theme.text-primary; }
            Text { vertical-stretch: 1; text: root.info; font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                FluentButton { horizontal-stretch: 1; text: @tr("Оставить локальную"); clicked => { root.open = false; root.resolve(0); } }
                FluentButton { horizontal-stretch: 1; primary: true; text: @tr("Загрузить из облака"); clicked => { root.open = false; root.resolve(1); } }
            }
        }
    }
}

export component ToastBanner inherits Rectangle {
    in property <string> message: "";
    height: 34px;
    border-radius: Win11Theme.radius-card;
    background: Win11Theme.card-bg;
    border-width: 1px;
    border-color: Win11Theme.accent;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000033;
    Text {
        text: root.message;
        font-family: Win11Theme.font-ui;
        font-size: 12px;
        font-weight: 500;
        color: Win11Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}
