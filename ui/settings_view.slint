import { ScrollView } from "std-widgets.slint";
import { Win11Theme, ModuleListItem } from "theme.slint";
import { AppState } from "globals.slint";
import { FluentButton } from "components.slint";
import { TorrServerSettingsSection } from "modules/torrserver/settings_section.slint";
import { CoreSettingsSection } from "settings_core_section.slint";

export component SettingsView inherits ScrollView {
    in-out property <int> ts-mode: 0;
    in-out property <string> ts-port: "8090";
    in-out property <string> ts-remote-url: "http://127.0.0.1:8090";
    in-out property <string> ts-username: "";
    in-out property <string> ts-password: "";
    in property <string> ts-engine-version-text: "";
    in property <bool> engine-updating: false;
    in property <string> engine-update-status: "";
    in property <float> engine-update-progress: 0.0;
    in property <[string]> engine-version-presets;
    in-out property <int> engine-version-selected-idx: 0;
    in property <bool> engine-versions-loading: false;
    in-out property <bool> engine-watchdog: true;
    in-out property <bool> keep-engine-on-exit: false;
    in-out property <string> kp-api-key: "";
    in property <string> ts-browser-url: "";
    in property <string> ts-lan-url: "";
    in property <bool> ts-has-lan-ip: false;
    in-out property <string> ts-cache-size-mb: "64";
    in-out property <string> ts-preload-percent: "50";
    in-out property <string> ts-read-ahead-percent: "95";
    in-out property <string> ts-connections-limit: "25";
    in-out property <bool> ts-use-disk: false;
    in-out property <bool> ts-enable-ipv6: false;
    in-out property <bool> ts-enable-dlna: false;
    in-out property <bool> ts-enable-rutor: true;
    in-out property <int> player-selected-idx: 0;
    in property <[string]> player-presets;
    in-out property <string> player-custom-path: "";
    in-out property <string> player-args: "";
    in-out property <bool> clipboard-watch: false;
    in property <string> player-detect-status: "";
    in-out property <bool> rt-enabled: false;
    in-out property <bool> rt-use-webview: false;
    in-out property <string> rt-mirror: "https://rutracker.org";
    in-out property <string> rt-username: "";
    in-out property <string> rt-password: "";
    in-out property <string> rt-proxy: "";
    in-out property <string> rt-cookie: "";
    in-out property <string> rt-user-agent: "";
    in property <string> rt-auth-status: "";
    in property <bool> rt-testing: false;

    in-out property <int> theme-mode: 0;
    in-out property <int> autostart-mode: 0;
    in property <bool> autostart-needs-repair: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> keep-in-memory: true;
    in property <[ModuleListItem]> registered-modules;
    in-out property <bool> webdav-enabled: false;
    in-out property <int> webdav-preset: 0;
    in-out property <string> webdav-url: "";
    in-out property <string> webdav-user: "";
    in-out property <string> webdav-pass: "";
    in-out property <bool> webdav-sync-db: false;
    in-out property <int> secret-mode: 0;
    in-out property <string> master-password: "";
    in-out property <bool> profiler-enabled: false;
    in property <string> profiler-cpu: "0%";
    in property <string> profiler-working-set: "0 МБ";
    in property <string> profiler-private-bytes: "0 МБ";
    in property <string> profiler-handles: "0";
    in property <string> profiler-gdi-user: "0 / 0";
    in property <string> profiler-crash-status: "";
    in property <string> app-version: "0.2.0";
    in property <string> changelog-text: "";
    in property <string> update-check-status: "";

    callback save-ts-connection-settings();
    callback restart-ts-engine();
    callback select-engine-version(int);
    callback refresh-engine-versions();
    callback download-update-engine();
    callback pick-engine-exe();
    callback open-web-panel();
    callback copy-ts-browser-url();
    callback copy-ts-lan-url();
    callback refresh-ts-addresses();
    callback save-ts-cache-settings();
    callback detect-players();
    callback pick-player-exe();
    callback save-player-settings();
    callback save-and-test-rutracker();
    callback open-rutracker-webview();
    callback change-theme-mode(int);
    callback change-language(int);
    callback set-autostart-mode(int);
    callback repair-autostart();
    callback toggle-start-minimized(bool);
    callback toggle-close-to-tray(bool);
    callback toggle-keep-in-memory(bool);
    callback save-webdav-settings();
    callback test-webdav-connection();
    callback sync-webdav-now();
    callback toggle-profiler(bool);
    callback export-profiler-report();
    callback check-github-updates();

    VerticalLayout {
        width: root.visible-width;
        padding: Win11Theme.is-mobile ? 8px : 14px;
        spacing: 8px;

        TorrServerSettingsSection {
            ts-mode <=> root.ts-mode; ts-port <=> root.ts-port; ts-remote-url <=> root.ts-remote-url;
            ts-username <=> root.ts-username; ts-password <=> root.ts-password; ts-engine-version-text: root.ts-engine-version-text;
            engine-updating: root.engine-updating; engine-update-status: root.engine-update-status; engine-update-progress: root.engine-update-progress;
            engine-version-presets: root.engine-version-presets; engine-version-selected-idx <=> root.engine-version-selected-idx;
            engine-versions-loading: root.engine-versions-loading; engine-watchdog <=> root.engine-watchdog;
            keep-engine-on-exit <=> root.keep-engine-on-exit; kp-api-key <=> root.kp-api-key;
            ts-browser-url: root.ts-browser-url; ts-lan-url: root.ts-lan-url; ts-has-lan-ip: root.ts-has-lan-ip;
            ts-cache-size-mb <=> root.ts-cache-size-mb; ts-preload-percent <=> root.ts-preload-percent;
            ts-read-ahead-percent <=> root.ts-read-ahead-percent; ts-connections-limit <=> root.ts-connections-limit;
            ts-use-disk <=> root.ts-use-disk; ts-enable-ipv6 <=> root.ts-enable-ipv6;
            ts-enable-dlna <=> root.ts-enable-dlna; ts-enable-rutor <=> root.ts-enable-rutor;
            player-selected-idx <=> root.player-selected-idx; player-presets: root.player-presets;
            player-custom-path <=> root.player-custom-path; player-args <=> root.player-args;
            clipboard-watch <=> root.clipboard-watch; player-detect-status: root.player-detect-status;
            rt-enabled <=> root.rt-enabled; rt-use-webview <=> root.rt-use-webview; rt-mirror <=> root.rt-mirror;
            rt-username <=> root.rt-username; rt-password <=> root.rt-password; rt-proxy <=> root.rt-proxy;
            rt-cookie <=> root.rt-cookie; rt-user-agent <=> root.rt-user-agent;
            rt-auth-status: root.rt-auth-status; rt-testing: root.rt-testing;
            save-ts-connection-settings => { root.save-ts-connection-settings(); }
            restart-ts-engine => { root.restart-ts-engine(); }
            select-engine-version(idx) => { root.select-engine-version(idx); }
            refresh-engine-versions => { root.refresh-engine-versions(); }
            download-update-engine => { root.download-update-engine(); }
            pick-engine-exe => { root.pick-engine-exe(); }
            open-web-panel => { root.open-web-panel(); }
            copy-ts-browser-url => { root.copy-ts-browser-url(); }
            copy-ts-lan-url => { root.copy-ts-lan-url(); }
            refresh-ts-addresses => { root.refresh-ts-addresses(); }
            save-ts-cache-settings => { root.save-ts-cache-settings(); }
            detect-players => { root.detect-players(); }
            pick-player-exe => { root.pick-player-exe(); }
            save-player-settings => { root.save-player-settings(); }
            save-and-test-rutracker => { root.save-and-test-rutracker(); }
            open-rutracker-webview => { root.open-rutracker-webview(); }
        }

        CoreSettingsSection {
            theme-mode <=> root.theme-mode; autostart-mode <=> root.autostart-mode;
            autostart-needs-repair: root.autostart-needs-repair; start-minimized <=> root.start-minimized;
            close-to-tray <=> root.close-to-tray; keep-in-memory <=> root.keep-in-memory;
            registered-modules: root.registered-modules; webdav-enabled <=> root.webdav-enabled;
            webdav-preset <=> root.webdav-preset; webdav-url <=> root.webdav-url;
            webdav-user <=> root.webdav-user; webdav-pass <=> root.webdav-pass;
            webdav-sync-db <=> root.webdav-sync-db; secret-mode <=> root.secret-mode;
            master-password <=> root.master-password; profiler-enabled <=> root.profiler-enabled;
            profiler-cpu: root.profiler-cpu; profiler-working-set: root.profiler-working-set;
            profiler-private-bytes: root.profiler-private-bytes; profiler-handles: root.profiler-handles;
            profiler-gdi-user: root.profiler-gdi-user; profiler-crash-status: root.profiler-crash-status;
            app-version: root.app-version; changelog-text: root.changelog-text;
            update-check-status: root.update-check-status;
            change-theme-mode(m) => { root.change-theme-mode(m); }
            change-language(l) => { root.change-language(l); }
            set-autostart-mode(m) => { root.set-autostart-mode(m); }
            repair-autostart => { root.repair-autostart(); }
            toggle-start-minimized(v) => { root.toggle-start-minimized(v); }
            toggle-close-to-tray(v) => { root.toggle-close-to-tray(v); }
            toggle-keep-in-memory(v) => { root.toggle-keep-in-memory(v); }
            save-webdav-settings => { root.save-webdav-settings(); }
            test-webdav-connection => { root.test-webdav-connection(); }
            sync-webdav-now => { root.sync-webdav-now(); }
            toggle-profiler(v) => { root.toggle-profiler(v); }
            export-profiler-report => { root.export-profiler-report(); }
            check-github-updates => { root.check-github-updates(); }
        }

        if (!Win11Theme.is-desktop) : FluentButton {
            text: @tr("Открыть диагностику");
            clicked => { AppState.mobile-detail-open = true; }
        }
    }
}
