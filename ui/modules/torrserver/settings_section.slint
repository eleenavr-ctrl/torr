import { ComboBox, LineEdit, Switch } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { FluentButton, SettingsExpander } from "../../components.slint";

export component TorrServerSettingsSection inherits VerticalLayout {
    spacing: 10px;

    // 1. Server & connection
    in-out property <int> ts-mode: 0;
    in-out property <string> ts-port: "8090";
    in-out property <string> ts-remote-url: "http://127.0.0.1:8090";
    in-out property <string> ts-username: "";
    in-out property <string> ts-password: "";
    in-out property <string> ts-engine-version-text: "Не обнаружен";
    in-out property <bool> engine-updating: false;
    in-out property <string> engine-update-status: "";
    in-out property <float> engine-update-progress: 0.0;

    // 2. Cache & network
    in-out property <string> ts-cache-size-mb: "64";
    in-out property <string> ts-preload-percent: "50";
    in-out property <string> ts-read-ahead-percent: "95";
    in-out property <string> ts-connections-limit: "25";
    in-out property <bool> ts-use-disk: false;
    in-out property <bool> ts-enable-ipv6: false;
    in-out property <bool> ts-enable-dlna: false;
    in-out property <bool> ts-enable-rutor: true;

    // 3. Players & clipboard
    in-out property <int> player-selected-idx: 0;
    in-out property <[string]> player-presets;
    in-out property <string> player-custom-path: "";
    in-out property <string> player-args: "";
    in-out property <bool> clipboard-watch: false;
    in-out property <string> player-detect-status: "";

    // 4. RuTracker Auth & Mirror
    in-out property <bool> rt-enabled: false;
    in-out property <string> rt-mirror: "https://rutracker.org";
    in-out property <string> rt-username: "";
    in-out property <string> rt-password: "";
    in-out property <string> rt-proxy: "";
    in-out property <string> rt-cookie: "";
    in-out property <string> rt-user-agent: "";
    in-out property <string> rt-auth-status: "";
    in-out property <bool> rt-testing: false;

    callback save-ts-connection-settings();
    callback restart-ts-engine();
    callback download-update-engine();
    callback pick-engine-exe();
    callback open-web-panel();
    callback save-ts-cache-settings();
    callback detect-players();
    callback pick-player-exe();
    callback save-player-settings();
    callback save-and-test-rutracker();

    // Accordion 1: Server & Connection
    SettingsExpander {
        title: "[Модуль TorrServer] Сервер и подключение";
        subtitle: "Локальный или удалённый режим, порт, авторизация и обновление движка";
        icon-path: "M 5 6 A 7 2.5 0 1 0 19 6 A 7 2.5 0 1 0 5 6 M 5 6 L 5 18 A 7 2.5 0 0 0 19 18 L 19 6 M 5 12 A 7 2.5 0 0 0 19 12";
        expanded: true;

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Режим работы:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            ComboBox {
                horizontal-stretch: 1;
                model: ["Локальный движок (data/torrserver)", "Удалённый сервер (URL)"];
                current-index <=> root.ts-mode;
            }
        }

        if (root.ts-mode == 0) : HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Локальный TCP-порт:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                width: 120px;
                text <=> root.ts-port;
                placeholder-text: "8090";
            }
            Text {
                text: "Версия движка: " + root.ts-engine-version-text;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
        }

        if (root.ts-mode == 1) : HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "URL удалённого сервера:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.ts-remote-url;
                placeholder-text: "http://192.168.1.10:8090";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "HTTP Basic Auth:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.ts-username;
                placeholder-text: "Логин (опционально)";
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.ts-password;
                input-type: InputType.password;
                placeholder-text: "Пароль (опционально)";
            }
        }

        if (root.engine-update-status != "" || root.engine-updating) : VerticalLayout {
            spacing: 6px;
            Text {
                text: root.engine-update-status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.accent;
                wrap: word-wrap;
            }
            if (root.engine-updating) : Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.border-color;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    height: 6px;
                    border-radius: 3px;
                    width: parent.width * clamp(root.engine-update-progress, 0.0, 1.0);
                    background: Theme.accent;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            FluentButton {
                text: "Сохранить и применить";
                primary: true;
                clicked => { root.save-ts-connection-settings(); }
            }
            FluentButton {
                text: "↻  Перезапустить движок";
                clicked => { root.restart-ts-engine(); }
            }
            FluentButton {
                text: root.engine-updating ? "Обновление..." : "⬇  Обновить с GitHub";
                enabled: !root.engine-updating;
                clicked => { root.download-update-engine(); }
            }
            FluentButton {
                text: "Указать .exe...";
                enabled: !root.engine-updating;
                clicked => { root.pick-engine-exe(); }
            }
            FluentButton {
                text: "🌐  Веб-панель";
                clicked => { root.open-web-panel(); }
            }
        }
    }

    // Accordion 2: Cache & Network
    SettingsExpander {
        title: "[Модуль TorrServer] Параметры кеша и сети";
        subtitle: "Размер буфера ОЗУ/диска, предзагрузка, лимит соединений, DLNA и RuTor";
        icon-path: "M 4 8 L 20 8 M 16 4 L 20 8 L 16 12 M 20 16 L 4 16 M 8 12 L 4 16 L 8 20";

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: "Размер кеша (МБ)"; font-family: Theme.font-ui; font-size: 12px; color: Theme.text-secondary; }
                LineEdit { text <=> root.ts-cache-size-mb; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: "Предзагрузка (%)"; font-family: Theme.font-ui; font-size: 12px; color: Theme.text-secondary; }
                LineEdit { text <=> root.ts-preload-percent; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: "Упреждение чтения (%)"; font-family: Theme.font-ui; font-size: 12px; color: Theme.text-secondary; }
                LineEdit { text <=> root.ts-read-ahead-percent; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: "Лимит соединений"; font-family: Theme.font-ui; font-size: 12px; color: Theme.text-secondary; }
                LineEdit { text <=> root.ts-connections-limit; }
            }
        }

        HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                spacing: 8px;
                Switch {
                    text: "Использовать диск для кеша (ts_cache)";
                    checked <=> root.ts-use-disk;
                }
                Switch {
                    text: "Включить IPv6";
                    checked <=> root.ts-enable-ipv6;
                }
            }
            VerticalLayout {
                spacing: 8px;
                Switch {
                    text: "Включить DLNA-сервер";
                    checked <=> root.ts-enable-dlna;
                }
                Switch {
                    text: "Встроенный поиск RuTor";
                    checked <=> root.ts-enable-rutor;
                }
            }
        }

        HorizontalLayout {
            FluentButton {
                text: "Применить параметры движка (/settings)";
                primary: true;
                clicked => { root.save-ts-cache-settings(); }
            }
        }
    }

    // Accordion 3: Players & Clipboard
    SettingsExpander {
        title: "[Модуль TorrServer] Видеоплееры и буфер";
        subtitle: "Автопоиск PotPlayer / MPV / VLC / MPC, путь к .exe, перехват Magnet";
        icon-path: "M 7 5 L 19 12 L 7 19 Z";

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Обнаруженный плеер:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            ComboBox {
                horizontal-stretch: 1;
                model: root.player-presets;
                current-index <=> root.player-selected-idx;
            }
            FluentButton {
                text: "Автопоиск";
                clicked => { root.detect-players(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Путь к плееру (.exe):";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.player-custom-path;
                placeholder-text: "Оставьте пустым для использования выбранного выше плеера";
            }
            FluentButton {
                text: "Обзор...";
                clicked => { root.pick-player-exe(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Доп. аргументы:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.player-args;
                placeholder-text: "Например: --fullscreen";
            }
        }

        Switch {
            text: "Автоматически перехватывать скопированные magnet:?xt=... ссылки из буфера обмена";
            checked <=> root.clipboard-watch;
        }

        if (root.player-detect-status != "") : Text {
            text: root.player-detect-status;
            font-family: Theme.font-ui;
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }

        HorizontalLayout {
            FluentButton {
                text: "Сохранить настройки плеера";
                primary: true;
                clicked => { root.save-player-settings(); }
            }
        }
    }

    // Accordion 4: RuTracker Auth & Mirror
    SettingsExpander {
        title: "[Модуль TorrServer] Поиск и авторизация RuTracker";
        subtitle: "Вход в ваш аккаунт RuTracker, зеркало и опциональный прокси";
        icon-path: "M 12 3 L 4 6.5 L 4 12 C 4 16.8 7.4 20.4 12 22 C 16.6 20.4 20 16.8 20 12 L 20 6.5 Z M 9.2 12.4 L 11.2 14.4 L 15.2 10.2";

        Switch {
            text: "Включить прямой поиск по RuTracker";
            checked <=> root.rt-enabled;
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Домен / зеркало:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.rt-mirror;
                placeholder-text: "https://rutracker.org";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Аккаунт RuTracker:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.rt-username;
                placeholder-text: "Логин";
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.rt-password;
                input-type: InputType.password;
                placeholder-text: "Пароль";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Прокси (опционально):";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.rt-proxy;
                placeholder-text: "Например: socks5h://127.0.0.1:1080 или http://127.0.0.1:8080";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "Cookie bb_session:";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.rt-cookie;
                input-type: InputType.password;
                placeholder-text: "bb_session=... (при 403/Cloudflare: bb_session=...; cf_clearance=...)";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                width: 180px;
                text: "User-Agent (опционально):";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.rt-user-agent;
                placeholder-text: "Как в браузере (для cf_clearance: F12 -> Console -> navigator.userAgent)";
            }
        }

        if (root.rt-auth-status != "") : Text {
            text: root.rt-auth-status;
            font-family: Theme.font-ui;
            font-size: 12px;
            color: Theme.accent;
            wrap: word-wrap;
        }

        HorizontalLayout {
            FluentButton {
                text: root.rt-testing ? "Проверка входа..." : "Сохранить и проверить вход";
                primary: true;
                enabled: !root.rt-testing;
                clicked => { root.save-and-test-rutracker(); }
            }
        }
    }
}
