import { ComboBox, LineEdit, Switch } from "std-widgets.slint";
import { Win11Theme } from "../../theme.slint";
import { FluentButton, SettingsExpander } from "../../components.slint";
import { RuTrackerSettingsExpander } from "settings_rutracker.slint";

export component TorrServerSettingsSection inherits VerticalLayout {
    spacing: 8px;

    // 1. Server & connection
    in-out property <int> ts-mode: 0;
    in-out property <string> ts-port: "8090";
    in-out property <string> ts-remote-url: "http://127.0.0.1:8090";
    in-out property <string> ts-username: "";
    in-out property <string> ts-password: "";
    in-out property <string> ts-engine-version-text: "Не обнаружен";
    in-out property <bool> engine-updating: false;
    in-out property <string> engine-update-status: "";
    in-out property <float> engine-update-progress: 0.0;
    in-out property <[string]> engine-version-presets;
    in-out property <int> engine-version-selected-idx: 0;
    in-out property <bool> engine-versions-loading: false;
    in-out property <bool> engine-watchdog: true;
    in-out property <bool> keep-engine-on-exit: false;
    in-out property <string> kp-api-key: "";
    in-out property <string> ts-browser-url: "http://127.0.0.1:8090";
    in-out property <string> ts-lan-url: "";
    in-out property <bool> ts-has-lan-ip: false;

    // 2. Cache & network
    in-out property <string> ts-cache-size-mb: "64";
    in-out property <string> ts-preload-percent: "50";
    in-out property <string> ts-read-ahead-percent: "95";
    in-out property <string> ts-connections-limit: "25";
    in-out property <bool> ts-use-disk: false;
    in-out property <bool> ts-enable-ipv6: false;
    in-out property <bool> ts-enable-dlna: false;
    in-out property <bool> ts-enable-rutor: true;

    // 3. Players & clipboard
    in-out property <int> player-selected-idx: 0;
    in-out property <[string]> player-presets;
    in-out property <string> player-custom-path: "";
    in-out property <string> player-args: "";
    in-out property <bool> clipboard-watch: false;
    in-out property <string> player-detect-status: "";

    // 4. RuTracker
    in-out property <bool> rt-enabled: false;
    in-out property <bool> rt-use-webview: false;
    in-out property <string> rt-mirror: "https://rutracker.org";
    in-out property <string> rt-username: "";
    in-out property <string> rt-password: "";
    in-out property <string> rt-proxy: "";
    in-out property <string> rt-cookie: "";
    in-out property <string> rt-user-agent: "";
    in-out property <string> rt-auth-status: "";
    in-out property <bool> rt-testing: false;

    callback save-ts-connection-settings();
    callback restart-ts-engine();
    callback select-engine-version(int);
    callback refresh-engine-versions();
    callback download-update-engine();
    callback pick-engine-exe();
    callback open-web-panel();
    callback copy-ts-browser-url();
    callback copy-ts-lan-url();
    callback refresh-ts-addresses();
    callback save-ts-cache-settings();
    callback detect-players();
    callback pick-player-exe();
    callback save-player-settings();
    callback save-and-test-rutracker();
    callback open-rutracker-webview();

    SettingsExpander {
        title: @tr("[Модуль TorrServer] Сервер и подключение");
        subtitle: (root.ts-mode == 0 ? ("127.0.0.1:" + root.ts-port + " • " + root.ts-engine-version-text) : root.ts-remote-url);
        icon-path: "M 5 6 A 7 2.5 0 1 0 19 6 A 7 2.5 0 1 0 5 6 M 5 6 L 5 18 A 7 2.5 0 0 0 19 18 L 19 6 M 5 12 A 7 2.5 0 0 0 19 12";
        expanded: true;

        HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 145px; text: @tr("Режим работы:"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            ComboBox { horizontal-stretch: 1; model: [@tr("Локальный движок"), @tr("Удалённый сервер")]; current-index <=> root.ts-mode; }
        }

        if (root.ts-mode == 0) : VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { width: Win11Theme.is-mobile ? 96px : 145px; text: @tr("Порт / Версия:"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
                LineEdit { width: 92px; text <=> root.ts-port; placeholder-text: "8090"; }
                ComboBox { horizontal-stretch: 1; model: root.engine-version-presets; current-index <=> root.engine-version-selected-idx; selected => { root.select-engine-version(self.current-index); } }
                FluentButton { compact: true; enabled: !root.engine-versions-loading && !root.engine-updating; icon-path: "M 20 11 A 8 8 0 1 0 18 17 M 20 4 L 20 11 L 13 11"; clicked => { root.refresh-engine-versions(); } }
            }
            Switch { text: @tr("Watchdog: автоперезапуск движка при выгрузке/сбое"); checked <=> root.engine-watchdog; }
            Switch { text: @tr("Оставлять процесс TorrServer MatriX в памяти при выходе"); checked <=> root.keep-engine-on-exit; }
        }

        if (root.ts-mode == 1) : HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 145px; text: @tr("URL сервера:"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            LineEdit { horizontal-stretch: 1; text <=> root.ts-remote-url; placeholder-text: "http://192.168.1.10:8090"; }
        }

        // Browser & Lampa LAN addresses informational block
        Rectangle {
            border-radius: Win11Theme.radius-ctrl;
            background: Win11Theme.subtle-bg;
            border-width: 1px;
            border-color: Win11Theme.border-color;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    Text { horizontal-stretch: 1; text: @tr("Адреса для браузера и Lampa (справка)"); font-family: Win11Theme.font-ui; font-size: 12px; font-weight: 600; color: Win11Theme.text-primary; vertical-alignment: center; }
                    FluentButton { compact: true; icon-path: "M 20 11 A 8 8 0 1 0 18 17 M 20 4 L 20 11 L 13 11"; clicked => { root.refresh-ts-addresses(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: Win11Theme.is-mobile ? 90px : 135px; text: @tr("Браузер (ПК):"); font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1; height: 28px; border-radius: Win11Theme.radius-ctrl; background: Win11Theme.input-bg; border-width: 1px; border-color: Win11Theme.border-color; clip: true;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; TextInput { horizontal-stretch: 1; text: root.ts-browser-url; read-only: true; single-line: true; font-family: Win11Theme.font-mono; font-size: 11px; color: Win11Theme.text-primary; vertical-alignment: center; } }
                    }
                    FluentButton { compact: true; text: @tr("Копия"); clicked => { root.copy-ts-browser-url(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { width: Win11Theme.is-mobile ? 90px : 135px; text: @tr("Для Lampa (LAN):"); font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1; height: 28px; border-radius: Win11Theme.radius-ctrl; background: Win11Theme.input-bg; border-width: 1px; border-color: root.ts-has-lan-ip ? Win11Theme.border-color : Win11Theme.status-warn; clip: true;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; TextInput { horizontal-stretch: 1; text: root.ts-lan-url; read-only: true; single-line: true; font-family: Win11Theme.font-mono; font-size: 11px; color: root.ts-has-lan-ip ? Win11Theme.accent : Win11Theme.text-secondary; vertical-alignment: center; } }
                    }
                    FluentButton { compact: true; text: @tr("Копия"); enabled: root.ts-has-lan-ip; clicked => { root.copy-ts-lan-url(); } }
                }
                Text {
                    text: root.ts-mode == 0
                        ? ("Lampa (ТВ/телефон): в Основную ссылку вводите " + (root.ts-has-lan-ip ? root.ts-lan-url : ("http://<IP_ПК>:" + root.ts-port)) + ", Дополнительная — для резервного сервера.")
                        : ("Lampa: укажите " + root.ts-browser-url + " в Основной ссылке.");
                    font-family: Win11Theme.font-ui; font-size: 10px; color: Win11Theme.text-secondary; wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 145px; text: "Basic Auth:"; font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            LineEdit { horizontal-stretch: 1; text <=> root.ts-username; placeholder-text: @tr("Логин"); }
            LineEdit { horizontal-stretch: 1; text <=> root.ts-password; input-type: InputType.password; placeholder-text: @tr("Пароль"); }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 145px; text: @tr("Ключ КП (опц.):"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            LineEdit { horizontal-stretch: 1; text <=> root.kp-api-key; input-type: InputType.password; placeholder-text: @tr("API-ключ Kinopoisk (опц.)"); }
        }

        if (root.engine-update-status != "" || root.engine-updating) : VerticalLayout {
            spacing: 4px;
            Text { text: root.engine-update-status; font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.accent; wrap: word-wrap; }
            if (root.engine-updating) : Rectangle {
                height: 4px; border-radius: 2px; background: Win11Theme.border-color;
                Rectangle { x: 0px; y: 0px; height: 4px; border-radius: 2px; width: parent.width * clamp(root.engine-update-progress, 0.0, 1.0); background: Win11Theme.accent; }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            FluentButton { compact: !Win11Theme.is-desktop; text: @tr("Сохранить"); primary: true; clicked => { root.save-ts-connection-settings(); } }
            FluentButton { compact: !Win11Theme.is-desktop; text: @tr("Рестарт"); clicked => { root.restart-ts-engine(); } }
            FluentButton { compact: !Win11Theme.is-desktop; text: @tr("Веб-панель"); clicked => { root.open-web-panel(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 6px;
            FluentButton { compact: true; text: root.engine-updating ? "..." : @tr("Обновить MatriX"); enabled: !root.engine-updating; clicked => { root.download-update-engine(); } }
            FluentButton { compact: true; text: ".exe..."; enabled: !root.engine-updating; clicked => { root.pick-engine-exe(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    SettingsExpander {
        title: @tr("[Модуль TorrServer] Кеш и сеть");
        subtitle: root.ts-cache-size-mb + " МБ • Preload " + root.ts-preload-percent + "% • Conn " + root.ts-connections-limit;
        icon-path: "M 4 8 L 20 8 M 16 4 L 20 8 L 16 12 M 20 16 L 4 16 M 8 12 L 4 16 L 8 20";

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { horizontal-stretch: 1; spacing: 3px; Text { text: @tr("Кеш (МБ)"); font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; } LineEdit { text <=> root.ts-cache-size-mb; } }
            VerticalLayout { horizontal-stretch: 1; spacing: 3px; Text { text: @tr("Предзагрузка %"); font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; } LineEdit { text <=> root.ts-preload-percent; } }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { horizontal-stretch: 1; spacing: 3px; Text { text: @tr("Read-ahead %"); font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; } LineEdit { text <=> root.ts-read-ahead-percent; } }
            VerticalLayout { horizontal-stretch: 1; spacing: 3px; Text { text: @tr("Соединения"); font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; } LineEdit { text <=> root.ts-connections-limit; } }
        }
        HorizontalLayout {
            spacing: 12px;
            Switch { horizontal-stretch: 1; text: @tr("Кеш на диск"); checked <=> root.ts-use-disk; }
            Switch { horizontal-stretch: 1; text: "IPv6"; checked <=> root.ts-enable-ipv6; }
        }
        HorizontalLayout {
            spacing: 12px;
            Switch { horizontal-stretch: 1; text: "DLNA"; checked <=> root.ts-enable-dlna; }
            Switch { horizontal-stretch: 1; text: "RuTor"; checked <=> root.ts-enable-rutor; }
        }
        HorizontalLayout {
            FluentButton { text: @tr("Применить параметры кеша"); primary: true; clicked => { root.save-ts-cache-settings(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    SettingsExpander {
        title: @tr("[Модуль TorrServer] Плееры и буфер обмена");
        subtitle: root.player-detect-status != "" ? root.player-detect-status : @tr("Автопоиск плееров и перехват Magnet");
        icon-path: "M 7 5 L 19 12 L 7 19 Z";

        HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 135px; text: @tr("Плеер:"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            ComboBox { horizontal-stretch: 1; model: root.player-presets; current-index <=> root.player-selected-idx; }
            FluentButton { compact: true; text: @tr("Найти"); clicked => { root.detect-players(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 135px; text: @tr("Свой .exe:"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            LineEdit { horizontal-stretch: 1; text <=> root.player-custom-path; placeholder-text: "C:\\Program Files\\DAUM\\PotPlayer\\PotPlayerMini64.exe"; }
            FluentButton { compact: true; text: @tr("Обзор..."); clicked => { root.pick-player-exe(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { width: Win11Theme.is-mobile ? 96px : 135px; text: @tr("Аргументы CLI:"); font-family: Win11Theme.font-ui; font-size: 12px; color: Win11Theme.text-primary; vertical-alignment: center; }
            LineEdit { horizontal-stretch: 1; text <=> root.player-args; placeholder-text: "--fullscreen"; }
        }
        Switch { text: @tr("Перехватывать magnet-ссылки из буфера обмена"); checked <=> root.clipboard-watch; }
        HorizontalLayout {
            FluentButton { text: @tr("Сохранить настройки плеера"); primary: true; clicked => { root.save-player-settings(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    RuTrackerSettingsExpander {
        rt-enabled <=> root.rt-enabled;
        rt-use-webview <=> root.rt-use-webview;
        rt-mirror <=> root.rt-mirror;
        rt-username <=> root.rt-username;
        rt-password <=> root.rt-password;
        rt-proxy <=> root.rt-proxy;
        rt-cookie <=> root.rt-cookie;
        rt-user-agent <=> root.rt-user-agent;
        rt-auth-status: root.rt-auth-status;
        rt-testing: root.rt-testing;
        save-and-test-rutracker => { root.save-and-test-rutracker(); }
        open-rutracker-webview => { root.open-rutracker-webview(); }
    }
}
