import { LineEdit, ScrollView } from "std-widgets.slint";
import { Win11Theme, SearchResultItem } from "../../theme.slint";
import { FluentCard, FluentButton, FilterPill, MediaBadge } from "../../components.slint";

export component SearchView inherits Rectangle {
    in-out property <string> search-query: "";
    in-out property <string> quality-filter: "ALL";
    in-out property <int> sort-mode: 0;
    in-out property <int> source-mode: 0;
    in-out property <bool> loading: false;
    in-out property <string> error-text: "";
    in-out property <[SearchResultItem]> results;

    callback search-torrents(string);
    callback fetch-top-24h();
    callback set-quality(string);
    callback set-sort(int);
    callback set-source(int);
    callback add-search-result(string, string, string);
    callback play-search-result(string, string, string);

    background: transparent;

    VerticalLayout {
        padding: Win11Theme.is-mobile ? 8px : 12px;
        spacing: 8px;

        FluentCard {
            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        height: Win11Theme.ctrl-h;
                        text <=> root.search-query;
                        placeholder-text: @tr("Название фильма, сериала или аниме...");
                        accepted => {
                            if (root.search-query != "") { root.search-torrents(root.search-query); }
                        }
                    }
                    FluentButton {
                        text: root.loading ? "..." : @tr("Найти");
                        primary: true;
                        enabled: !root.loading;
                        icon-path: "M 11 4 A 7 7 0 1 0 11 18 A 7 7 0 1 0 11 4 M 16 16 L 21 21";
                        clicked => {
                            if (root.search-query != "") { root.search-torrents(root.search-query); }
                        }
                    }
                    FluentButton {
                        text: @tr("Топ 24ч");
                        enabled: !root.loading;
                        icon-path: "M 12 3 C 15 7 18 10 18 14 A 6 6 0 1 1 6 14 C 6 11 8 9 9 7 C 10 9 11 10 12 3 Z";
                        clicked => { root.fetch-top-24h(); }
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    FilterPill { text: @tr("Все"); active: root.source-mode == 0; clicked => { root.set-source(0); } }
                    FilterPill { text: "RuTor"; active: root.source-mode == 1; clicked => { root.set-source(1); } }
                    FilterPill { text: "RuTracker"; active: root.source-mode == 2; clicked => { root.set-source(2); } }
                    FilterPill { text: "JacRed"; active: root.source-mode == 3; clicked => { root.set-source(3); } }
                    Rectangle { horizontal-stretch: 1; }
                    if (!Win11Theme.is-mobile) : HorizontalLayout {
                        spacing: 4px;
                        FilterPill { text: "ALL"; active: root.quality-filter == "ALL"; clicked => { root.set-quality("ALL"); } }
                        FilterPill { text: "1080p"; active: root.quality-filter == "1080p"; clicked => { root.set-quality("1080p"); } }
                        FilterPill { text: "4K"; active: root.quality-filter == "4K"; clicked => { root.set-quality("4K"); } }
                        FilterPill { text: "HDR"; active: root.quality-filter == "HDR"; clicked => { root.set-quality("HDR"); } }
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    FilterPill { text: @tr("Сиды"); active: root.sort-mode == 0; clicked => { root.set-sort(0); } }
                    FilterPill { text: @tr("Дата"); active: root.sort-mode == 1; clicked => { root.set-sort(1); } }
                    FilterPill { text: @tr("Размер"); active: root.sort-mode == 2; clicked => { root.set-sort(2); } }
                    FilterPill { text: @tr("Имя"); active: root.sort-mode == 3; clicked => { root.set-sort(3); } }
                }
            }
        }

        if (root.error-text != "") : Rectangle {
            border-radius: Win11Theme.radius-ctrl;
            background: Win11Theme.danger-bg;
            border-width: 1px;
            border-color: Win11Theme.status-err;
            HorizontalLayout {
                padding: 8px;
                Text { text: root.error-text; font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.status-err; wrap: word-wrap; }
            }
        }

        FluentCard {
            vertical-stretch: 1;
            clip: true;

            if (root.results.length == 0) : VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.loading ? @tr("Загрузка раздач с трекеров...") : @tr("Введите запрос или откройте Топ 24ч");
                    font-family: Win11Theme.font-ui;
                    font-size: 13px;
                    font-weight: 600;
                    color: Win11Theme.text-primary;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    FluentButton {
                        text: @tr("Показать Топ 24ч");
                        enabled: !root.loading;
                        icon-path: "M 12 3 C 15 7 18 10 18 14 A 6 6 0 1 1 6 14 C 6 11 8 9 9 7 C 10 9 11 10 12 3 Z";
                        clicked => { root.fetch-top-24h(); }
                    }
                }
            }

            if (root.results.length > 0) : sv-search := ScrollView {
                VerticalLayout {
                    width: sv-search.visible-width;
                    padding: 6px;
                    spacing: 4px;

                    for res in root.results : Rectangle {
                        border-radius: Win11Theme.radius-ctrl;
                        border-width: 1px;
                        border-color: Win11Theme.border-color;
                        background: res-ta.has-hover ? Win11Theme.card-hover : Win11Theme.subtle-bg;
                        res-ta := TouchArea { mouse-cursor: default; }

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text {
                                    text: res.title;
                                    font-family: Win11Theme.font-ui;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Win11Theme.text-primary;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    MediaBadge { text: res.tracker; }
                                    if (res.quality != "") : MediaBadge {
                                        text: res.quality;
                                        badge-bg: Win11Theme.info-bg;
                                        text-color: Win11Theme.accent;
                                    }
                                    Text { text: res.size-text; font-family: Win11Theme.font-mono; font-size: 10px; color: Win11Theme.text-secondary; vertical-alignment: center; }
                                    if (res.date-text != "") : Text { text: res.date-text; font-family: Win11Theme.font-ui; font-size: 10px; color: Win11Theme.text-secondary; vertical-alignment: center; }
                                    Text {
                                        text: "S:" + res.seeds + " / P:" + res.peers;
                                        font-family: Win11Theme.font-mono;
                                        font-size: 10px;
                                        color: res.seeds > 5 ? Win11Theme.status-ok : Win11Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                FluentButton {
                                    compact: true;
                                    text: Win11Theme.is-mobile ? "" : @tr("В раздачи");
                                    icon-path: "M 12 5 L 12 19 M 5 12 L 19 12";
                                    clicked => { root.add-search-result(res.magnet, res.title, res.page-url); }
                                }
                                FluentButton {
                                    compact: true;
                                    primary: true;
                                    text: Win11Theme.is-mobile ? "" : @tr("Смотреть");
                                    icon-path: "M 7 5 L 19 12 L 7 19 Z";
                                    clicked => { root.play-search-result(res.magnet, res.title, res.page-url); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
