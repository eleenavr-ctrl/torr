import { CheckBox, ScrollView } from "std-widgets.slint";
import { Win11Theme, HistoryItem } from "../../theme.slint";
import { FluentCard, FluentButton, SvgIcon } from "../../components.slint";

export component HistoryView inherits Rectangle {
    in-out property <bool> only-favorites: false;
    in-out property <[HistoryItem]> items;

    callback toggle-favorites-filter(bool);
    callback play-history-item(string, string);
    callback toggle-favorite(string);
    callback remove-history-item(string);

    background: transparent;

    VerticalLayout {
        padding: Win11Theme.is-mobile ? 8px : 12px;
        spacing: 8px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: @tr("История просмотров и избранное");
                font-family: Win11Theme.font-ui;
                font-size: 14px;
                font-weight: 600;
                color: Win11Theme.text-primary;
                vertical-alignment: center;
            }
            CheckBox {
                text: @tr("Только избранное");
                checked <=> root.only-favorites;
                toggled => { root.toggle-favorites-filter(self.checked); }
            }
        }

        FluentCard {
            vertical-stretch: 1;
            clip: true;

            if (root.items.length == 0) : VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: root.only-favorites ? @tr("В избранном пока пусто") : @tr("История просмотров пуста");
                    font-family: Win11Theme.font-ui;
                    font-size: 13px;
                    font-weight: 600;
                    color: Win11Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Запустите видеофайл из раздачи, чтобы сохранить прогресс просмотра.");
                    font-family: Win11Theme.font-ui;
                    font-size: 11px;
                    color: Win11Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            if (root.items.length > 0) : sv-hist := ScrollView {
                VerticalLayout {
                    width: sv-hist.visible-width;
                    padding: 6px;
                    spacing: 4px;

                    for item in root.items : Rectangle {
                        border-radius: Win11Theme.radius-ctrl;
                        border-width: 1px;
                        border-color: Win11Theme.border-color;
                        background: h-ta.has-hover ? Win11Theme.card-hover : Win11Theme.subtle-bg;
                        h-ta := TouchArea { mouse-cursor: default; }

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: item.favorite ? Win11Theme.info-bg : transparent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.toggle-favorite(item.hash); } }
                                SvgIcon {
                                    x: 6px; y: 6px; icon-size: 16px;
                                    commands: "M 12 3 L 14.8 8.8 L 21 9.6 L 16.5 14 L 17.6 20.2 L 12 17.2 L 6.4 20.2 L 7.5 14 L 3 9.6 L 9.2 8.8 Z";
                                    stroke-color: item.favorite ? Win11Theme.status-warn : Win11Theme.text-secondary;
                                    fill-color: item.favorite ? Win11Theme.status-warn : transparent;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: item.title;
                                    font-family: Win11Theme.font-ui;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Win11Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.last-opened + "  •  " + item.watched-count + " / " + item.total-files;
                                    font-family: Win11Theme.font-ui;
                                    font-size: 10px;
                                    color: item.watched-count > 0 ? Win11Theme.status-ok : Win11Theme.text-secondary;
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                FluentButton {
                                    compact: true;
                                    primary: true;
                                    text: Win11Theme.is-mobile ? "" : @tr("Открыть");
                                    icon-path: "M 7 5 L 19 12 L 7 19 Z";
                                    clicked => { root.play-history-item(item.hash, item.magnet); }
                                }
                                FluentButton {
                                    compact: true;
                                    danger: true;
                                    icon-path: "M 6 6 L 18 18 M 18 6 L 6 18";
                                    clicked => { root.remove-history-item(item.hash); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
