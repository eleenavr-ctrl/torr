import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Win11Theme, TorrentItem } from "../../theme.slint";
import { AppState } from "../../globals.slint";
import { FluentCard, FluentButton, FluentMenuItem, FilterPill, SvgIcon } from "../../components.slint";
import { DenseTorrentRow } from "../../torrent_row.slint";

export component TorrentsView inherits Rectangle {
    in-out property <string> magnet-input: "";
    in-out property <[TorrentItem]> torrents;
    in-out property <int> torrents-sort-mode: 0;
    in-out property <string> selected-torrent-hash: "";
    in-out property <bool> engine-missing: false;
    in-out property <bool> engine-updating: false;
    in-out property <string> engine-update-status: "";
    in-out property <float> engine-update-progress: 0.0;
    in-out property <[string]> engine-version-presets;
    in-out property <int> engine-version-selected-idx: 0;
    in-out property <bool> engine-versions-loading: false;
    in-out property <bool> is-remote-mode: false;
    in-out property <bool> status-healthy: false;

    // Info Modal
    in-out property <bool> torrent-info-visible: false;
    in-out property <string> info-hash: "";
    in-out property <string> info-title: "";
    in-out property <string> info-size: "";
    in-out property <string> info-added: "";
    in-out property <string> info-status: "";
    in-out property <string> info-speed: "";
    in-out property <string> info-peers: "";
    in-out property <string> info-files-count: "";
    in-out property <string> info-tracker-url: "";
    in-out property <string> info-ratings: "";
    in-out property <string> info-magnet: "";

    callback add-magnet(string);
    callback paste-and-add-magnet();
    callback pick-torrent-file();
    callback select-torrent(string);
    callback refresh-torrents();
    callback set-torrents-sort(int);
    callback set-torrents-filter(int);
    callback drop-torrent(string);
    callback remove-torrent(string);
    callback copy-torrent-magnet(string);
    callback play-file(string, int);
    callback select-engine-version(int);
    callback refresh-engine-versions();
    callback download-update-engine();
    callback pick-engine-exe();
    callback export-torrents();
    callback import-torrents();
    callback download-torrent-playlist(string);
    callback download-all-playlist();
    callback refresh-single-torrent(string);
    callback show-torrent-info(string);
    callback open-tracker-page(string);

    property <length> ctx-x: 0px;
    property <length> ctx-y: 0px;
    property <string> ctx-torrent-hash: "";
    background: transparent;

    torrent-ctx-menu := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        width: 280px;
        height: 262px;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Win11Theme.card-bg;
            border-radius: Win11Theme.radius-card;
            border-width: 1px;
            border-color: Win11Theme.border-color;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                FluentMenuItem { text: @tr("Воспроизвести"); icon-path: "M 7 5 L 19 12 L 7 19 Z"; clicked => { torrent-ctx-menu.close(); root.play-file(root.ctx-torrent-hash, -1); } }
                FluentMenuItem { text: @tr("Скачать плейлист торрента"); icon-path: "M 4 6 L 16 6 M 4 12 L 16 12 M 4 18 L 12 18 M 17 15 L 21 17.5 L 17 20 Z"; clicked => { torrent-ctx-menu.close(); root.download-torrent-playlist(root.ctx-torrent-hash); } }
                FluentMenuItem { text: @tr("Скопировать магнет-ссылку"); icon-path: "M 10 14 L 14 10 M 7 17 A 4 4 0 0 1 7 11 L 9 9 M 17 7 A 4 4 0 0 1 17 13 L 15 15"; clicked => { torrent-ctx-menu.close(); root.copy-torrent-magnet(root.ctx-torrent-hash); } }
                FluentMenuItem { text: @tr("Удалить с сервера"); icon-path: "M 4 6 L 20 6 M 9 6 L 9 4 L 15 4 L 15 6 M 7 6 L 8 20 L 16 20 L 17 6"; danger: true; clicked => { torrent-ctx-menu.close(); root.remove-torrent(root.ctx-torrent-hash); } }
                FluentMenuItem { text: @tr("Обновить торрент"); icon-path: "M 20 11 A 8 8 0 1 0 18 17 M 20 4 L 20 11 L 13 11"; clicked => { torrent-ctx-menu.close(); root.refresh-single-torrent(root.ctx-torrent-hash); } }
                FluentMenuItem { text: @tr("Получить информацию о торренте"); icon-path: "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 M 12 11 L 12 16 M 12 8 L 12 8.5"; clicked => { torrent-ctx-menu.close(); root.show-torrent-info(root.ctx-torrent-hash); } }
                FluentMenuItem { text: @tr("Страница раздачи на трекере"); icon-path: "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 M 3 12 L 21 12"; clicked => { torrent-ctx-menu.close(); root.open-tracker-page(root.ctx-torrent-hash); } }
                FluentMenuItem { text: @tr("Скачать плейлист всех торрентов"); icon-path: "M 4 6 L 16 6 M 4 12 L 16 12 M 4 18 L 12 18 M 17 15 L 21 17.5 L 17 20 Z"; clicked => { torrent-ctx-menu.close(); root.download-all-playlist(); } }
            }
        }
    }

    VerticalLayout {
        padding: Win11Theme.is-mobile ? 8px : 12px;
        spacing: 8px;

        // Compact Top Action Toolbar (34px desktop / 42px mobile)
        HorizontalLayout {
            spacing: 6px;
            LineEdit {
                horizontal-stretch: 1;
                height: Win11Theme.ctrl-h;
                text <=> root.magnet-input;
                placeholder-text: @tr("Magnet-ссылка или infohash...");
                accepted => {
                    if (root.magnet-input != "") { root.add-magnet(root.magnet-input); }
                }
            }
            FluentButton {
                primary: true;
                icon-path: "M 12 5 L 12 19 M 5 12 L 19 12";
                text: Win11Theme.is-desktop ? @tr("Добавить") : "";
                clicked => {
                    if (root.magnet-input != "") { root.add-magnet(root.magnet-input); }
                }
            }
            FluentButton {
                icon-path: "M 9 4 L 15 4 L 15 6 L 9 6 Z M 7 5 L 5 5 L 5 20 L 19 20 L 19 5 L 17 5";
                clicked => { root.paste-and-add-magnet(); }
            }
            FluentButton {
                icon-path: "M 3 6 L 9 6 L 11 8 L 21 8 L 21 19 L 3 19 Z";
                text: Win11Theme.is-desktop ? ".torrent" : "";
                clicked => { root.pick-torrent-file(); }
            }
            if (!Win11Theme.is-mobile) : FluentButton {
                icon-path: "M 7 5 L 10 5 L 10 19 L 7 19 Z M 14 5 L 17 5 L 17 19 L 14 19 Z";
                clicked => {
                    if (root.selected-torrent-hash != "") { root.drop-torrent(root.selected-torrent-hash); }
                }
            }
            FluentButton {
                icon-path: "M 20 11 A 8 8 0 1 0 18 17 M 20 4 L 20 11 L 13 11";
                clicked => { root.refresh-torrents(); }
            }
        }

        // Live Telemetry Strip
        Rectangle {
            height: Win11Theme.is-mobile ? 28px : 26px;
            border-radius: Win11Theme.radius-ctrl;
            background: Win11Theme.card-bg;
            border-width: 1px;
            border-color: Win11Theme.border-color;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;
                Text {
                    text: "↓ " + AppState.telemetry-down-speed + "  •  ↑ " + AppState.telemetry-up-speed;
                    font-family: Win11Theme.font-mono;
                    font-size: 11px;
                    font-weight: 600;
                    color: Win11Theme.accent;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("Кеш:") + " " + AppState.telemetry-cache-usage;
                    font-family: Win11Theme.font-ui;
                    font-size: 11px;
                    color: Win11Theme.text-secondary;
                    vertical-alignment: center;
                }
                if (!Win11Theme.is-mobile) : Text {
                    text: @tr("Буфер:") + " " + AppState.telemetry-buffer-pct + "%";
                    font-family: Win11Theme.font-ui;
                    font-size: 11px;
                    color: Win11Theme.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "API: " + AppState.telemetry-ping;
                    font-family: Win11Theme.font-mono;
                    font-size: 11px;
                    color: root.status-healthy ? Win11Theme.status-ok : Win11Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        // Filter Pills with Counters
        HorizontalLayout {
            spacing: 5px;
            FilterPill { text: @tr("Все"); count: AppState.count-all; active: AppState.filter-mode == 0; clicked => { AppState.filter-mode = 0; root.set-torrents-filter(0); } }
            FilterPill { text: @tr("Активные"); count: AppState.count-active; active: AppState.filter-mode == 1; clicked => { AppState.filter-mode = 1; root.set-torrents-filter(1); } }
            if (!Win11Theme.is-mobile) : FilterPill { text: @tr("4K / HDR"); count: AppState.count-4k; active: AppState.filter-mode == 2; clicked => { AppState.filter-mode = 2; root.set-torrents-filter(2); } }
            if (!Win11Theme.is-mobile) : FilterPill { text: @tr("Сериалы"); count: AppState.count-series; active: AppState.filter-mode == 3; clicked => { AppState.filter-mode = 3; root.set-torrents-filter(3); } }
            FilterPill { text: @tr("Завершённые"); count: AppState.count-completed; active: AppState.filter-mode == 4; clicked => { AppState.filter-mode = 4; root.set-torrents-filter(4); } }
            Rectangle { horizontal-stretch: 1; }
        }

        // Sort + Backup toolbar row
        if (!Win11Theme.is-mobile) : HorizontalLayout {
            spacing: 6px;
            ComboBox {
                width: 156px;
                model: [@tr("Новые сверху"), @tr("Старые сверху"), @tr("По названию"), @tr("По размеру"), @tr("По скорости")];
                current-index <=> root.torrents-sort-mode;
                selected => { root.set-torrents-sort(self.current-index); }
            }
            Rectangle { horizontal-stretch: 1; }
            if (Win11Theme.is-desktop) : FluentButton { compact: true; text: @tr("Экспорт"); clicked => { root.export-torrents(); } }
            if (Win11Theme.is-desktop) : FluentButton { compact: true; text: @tr("Импорт"); clicked => { root.import-torrents(); } }
        }

        // Engine Missing / Update Banner
        if (!root.is-remote-mode && ((root.engine-missing && !root.status-healthy) || root.engine-updating)) : Rectangle {
            border-radius: Win11Theme.radius-card;
            background: Win11Theme.info-bg;
            border-width: 1px;
            border-color: Win11Theme.accent;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.engine-updating ? root.engine-update-status : @tr("Требуется движок TorrServer MatriX для локального режима");
                        font-family: Win11Theme.font-ui;
                        font-size: 12px;
                        font-weight: 600;
                        color: Win11Theme.text-primary;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    if (!root.engine-updating) : ComboBox {
                        width: 190px;
                        model: root.engine-version-presets;
                        current-index <=> root.engine-version-selected-idx;
                        selected => { root.select-engine-version(self.current-index); }
                    }
                    FluentButton {
                        compact: true;
                        primary: true;
                        text: root.engine-updating ? "..." : @tr("Скачать");
                        enabled: !root.engine-updating;
                        clicked => { root.download-update-engine(); }
                    }
                    FluentButton {
                        compact: true;
                        text: ".exe...";
                        enabled: !root.engine-updating;
                        clicked => { root.pick-engine-exe(); }
                    }
                }
                if (root.engine-updating) : Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Win11Theme.border-color;
                    Rectangle {
                        x: 0px; y: 0px; height: 4px; border-radius: 2px;
                        width: parent.width * clamp(root.engine-update-progress, 0.0, 1.0);
                        background: Win11Theme.accent;
                    }
                }
            }
        }

        // Dense Torrents List
        FluentCard {
            vertical-stretch: 1;
            clip: true;

            if (root.torrents.length == 0) : VerticalLayout {
                alignment: center;
                padding: 24px;
                spacing: 6px;
                Text {
                    text: @tr("Список раздач пуст");
                    font-family: Win11Theme.font-ui;
                    font-size: 14px;
                    font-weight: 600;
                    color: Win11Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Вставьте Magnet-ссылку сверху, перетащите .torrent-файл или откройте Поиск.");
                    font-family: Win11Theme.font-ui;
                    font-size: 11px;
                    color: Win11Theme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if (root.torrents.length > 0) : sv-list := ScrollView {
                VerticalLayout {
                    width: sv-list.visible-width;
                    padding: 6px;
                    spacing: 4px;
                    for t in root.torrents : DenseTorrentRow {
                        title: t.title;
                        quality-tag: t.quality-tag;
                        tracker-tag: t.tracker-tag;
                        down-speed: t.down-speed;
                        up-speed: t.up-speed;
                        size-text: t.size-text;
                        peers-text: t.peers-text;
                        cache-text: t.cache-text;
                        status-text: t.status-text;
                        progress: t.progress;
                        is-active: t.is-active;
                        selected: t.is-selected;

                        row-clicked => {
                            root.select-torrent(t.hash);
                            if (!Win11Theme.is-desktop) {
                                AppState.mobile-detail-open = true;
                            }
                        }
                        row-double-clicked => { root.play-file(t.hash, -1); }
                        row-context(ax, ay) => {
                            root.ctx-torrent-hash = t.hash;
                            root.ctx-x = min(ax - root.absolute-position.x, max(0px, root.width - 284px));
                            root.ctx-y = min(ay - root.absolute-position.y, max(0px, root.height - 266px));
                            torrent-ctx-menu.show();
                        }
                        more-clicked(ax, ay) => {
                            root.ctx-torrent-hash = t.hash;
                            root.ctx-x = min(ax - root.absolute-position.x - 240px, max(0px, root.width - 284px));
                            root.ctx-y = min(ay - root.absolute-position.y, max(0px, root.height - 266px));
                            torrent-ctx-menu.show();
                        }
                        play-clicked => { root.play-file(t.hash, -1); }
                        playlist-clicked => { root.download-torrent-playlist(t.hash); }
                        magnet-clicked => { root.copy-torrent-magnet(t.hash); }
                        remove-clicked => { root.remove-torrent(t.hash); }
                    }
                }
            }
        }
    }

    // Torrent Info Modal
    if (root.torrent-info-visible) : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.torrent-info-visible = false; } }
        FluentCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 24px, 520px);
            height: min(parent.height - 24px, 400px);
            TouchArea { }
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Информация о торренте");
                        font-family: Win11Theme.font-ui;
                        font-size: 15px;
                        font-weight: 600;
                        color: Win11Theme.text-primary;
                        vertical-alignment: center;
                    }
                    FluentButton { compact: true; icon-path: "M 6 6 L 18 18 M 18 6 L 6 18"; clicked => { root.torrent-info-visible = false; } }
                }
                Rectangle { height: 1px; background: Win11Theme.border-color; }
                sv-info := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: sv-info.visible-width;
                        spacing: 6px;
                        Text { text: root.info-title; font-family: Win11Theme.font-ui; font-size: 13px; font-weight: 600; color: Win11Theme.text-primary; wrap: word-wrap; }
                        Text { text: "Hash: " + root.info-hash; font-family: Win11Theme.font-mono; font-size: 11px; color: Win11Theme.accent; wrap: word-wrap; }
                        Text { text: root.info-size + " • " + root.info-files-count + " • " + root.info-status + " • " + root.info-speed; font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.text-secondary; wrap: word-wrap; }
                        if (root.info-ratings != "") : Text { text: root.info-ratings; font-family: Win11Theme.font-ui; font-size: 11px; font-weight: 600; color: Win11Theme.text-primary; }
                        if (root.info-tracker-url != "") : Text { text: root.info-tracker-url; font-family: Win11Theme.font-ui; font-size: 11px; color: Win11Theme.accent; wrap: word-wrap; }
                        Text { text: root.info-magnet; font-family: Win11Theme.font-mono; font-size: 10px; color: Win11Theme.text-secondary; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    FluentButton { text: @tr("Копировать Magnet"); primary: true; clicked => { root.copy-torrent-magnet(root.info-hash); } }
                    if (root.info-tracker-url != "") : FluentButton { text: @tr("Трекер"); clicked => { root.open-tracker-page(root.info-hash); } }
                    Rectangle { horizontal-stretch: 1; }
                    FluentButton { text: @tr("Закрыть"); clicked => { root.torrent-info-visible = false; } }
                }
            }
        }
    }
}
