export struct TorrentItem {
    hash: string,
    title: string,
    size-text: string,
    speed-text: string,
    down-speed: string,
    up-speed: string,
    cache-text: string,
    peers-text: string,
    progress: float,
    status-text: string,
    added-text: string,
    quality-tag: string,
    tracker-tag: string,
    is-active: bool,
    is-series: bool,
    is-completed: bool,
    magnet: string,
    is-selected: bool,
}

export struct PeerItem {
    addr: string,
    client: string,
    progress: string,
    speed: string,
    flags: string,
}

export struct SpeedSample {
    label: string,
    ratio: float,
}

export struct TorrentFileItem {
    id: int,
    index: int,
    name: string,
    path: string,
    size-text: string,
    codec-tag: string,
    stream-url: string,
    is-video: bool,
    is-watched: bool,
}

export struct SearchResultItem {
    title: string,
    magnet: string,
    size-text: string,
    size-bytes: float,
    seeds: int,
    peers: int,
    quality: string,
    tracker: string,
    date-text: string,
    page-url: string,
}

export struct ScreenshotItem {
    img: image,
    url: string,
}

export struct HistoryItem {
    hash: string,
    title: string,
    magnet: string,
    last-opened: string,
    watched-count: int,
    total-files: int,
    favorite: bool,
}

export struct LogEntry {
    timestamp: string,
    tag: string,
    level: string,
    message: string,
}

export struct ModuleListItem {
    id: string,
    name: string,
    version: string,
    description: string,
    status: string,
    enabled: bool,
    is-external: bool,
}

export struct WorkspaceBlockItem {
    id: string,
    module-id: string,
    title: string,
    span: int, // 1 = 1/3, 2 = 2/3, 3 = 3/3
    order: int,
}

export global Win11Theme {
    // 0 = Adaptive (System), 1 = Light (White), 2 = Dark
    in-out property <int> theme-mode: 0;
    in-out property <bool> system-is-dark: false;
    in-out property <color> system-accent: #0067C0;
    in-out property <length> viewport-width: 1280px;

    out property <bool> is-dark: theme-mode == 2 || (theme-mode == 0 && system-is-dark);

    // Three-tier adaptive breakpoints
    out property <bool> is-desktop: viewport-width >= 1024px;
    out property <bool> is-tablet: viewport-width >= 680px && viewport-width < 1024px;
    out property <bool> is-mobile: viewport-width < 680px;

    // Adaptive touch & density sizing tokens
    out property <length> ctrl-h: is-mobile ? 42px : 32px;
    out property <length> btn-compact-h: is-mobile ? 38px : 26px;
    out property <length> row-h: is-mobile ? 64px : 56px;
    out property <length> file-row-h: is-mobile ? 40px : 28px;
    out property <length> touch-target: is-mobile ? 44px : 28px;
    out property <length> sidebar-w: is-desktop ? 184px : (is-tablet ? 56px : 0px);
    out property <length> detail-w: is-desktop ? 320px : 0px;

    // Windows 11 Light Mica / Dark Mica Palettes
    out property <color> window-bg: is-dark ? #202020 : #F3F3F3;
    out property <color> sidebar-bg: is-dark ? #1C1C1C : #EAEAEA;
    out property <color> card-bg: is-dark ? #2B2B2B : #FFFFFF;
    out property <color> card-hover: is-dark ? #323232 : #F9F9F9;
    out property <color> card-selected: is-dark ? #243442 : #EBF3FC;
    out property <color> border-color: is-dark ? #383838 : #E5E5E5;

    out property <color> text-primary: is-dark ? #FFFFFF : #1A1A1A;
    out property <color> text-secondary: is-dark ? #CCCCCC : #5D5D5D;

    out property <color> accent: is-dark ? #60CDFF : #0067C0;
    out property <color> accent-hover: is-dark ? #77D5FF : #1975C5;
    out property <color> text-on-accent: is-dark ? #000000 : #FFFFFF;
    out property <color> accent-text: text-on-accent;

    out property <color> status-ok: is-dark ? #6CCB5F : #0F7B0F;
    out property <color> status-warn: is-dark ? #FCE100 : #9D5D00;
    out property <color> status-err: is-dark ? #FF99A4 : #C42B1C;
    out property <color> success: status-ok;
    out property <color> warning: status-warn;
    out property <color> danger: status-err;

    // Surface & semantic tokens
    out property <color> nav-hover: is-dark ? #2D2D2D : #E0E0E0;
    out property <color> nav-active: is-dark ? #333333 : #DCDCDC;
    out property <color> subtle-bg: is-dark ? #252525 : #FAFAFA;
    out property <color> input-bg: is-dark ? #2F2F2F : #FFFFFF;
    out property <color> danger-bg: is-dark ? #442726 : #FDE7E9;
    out property <color> info-bg: is-dark ? #223544 : #EFF6FC;
    out property <color> log-bg: is-dark ? #161616 : #F7F7F7;
    out property <color> badge-bg: is-dark ? #3A3A3A : #EFEFEF;

    // Typography & geometry
    out property <string> font-ui: "Segoe UI Variable";
    out property <string> font-mono: "Consolas";
    out property <length> radius-card: 8px;
    out property <length> radius-ctrl: 4px;
}
